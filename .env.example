# ---------------------------------------------------------------------------
# Multi-Agent AI Care Coordinator - copy to .env and fill in when AMD access arrives.
# Everything AMD-related is EMPTY on purpose: with these blank the app runs in
# "rules mode" (deterministic Python agents, no model, GPU panel "not connected").
# ---------------------------------------------------------------------------

# Main open model served by vLLM on AMD (MI300X / AMD Developer Cloud / token factory).
# Any OpenAI-compatible base URL ending in /v1. All six agents share this one endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=120

# Small safety classifier on the same GPU (optional; falls back to LLM_BASE_URL/LLM_API_KEY).
SAFETY_BASE_URL=
SAFETY_API_KEY=
SAFETY_MODEL=

# Path to amd-smi on the MI300X host (e.g. /opt/rocm/bin/amd-smi). Empty = GPU panel "not connected".
AMD_SMI_PATH=

# Pipeline
MAX_RETRIES=2
TARGET_GRADE=8
# Folder whose sub-folders are synthetic patients (one folder per patient)
SAMPLE_DATA_DIR=
